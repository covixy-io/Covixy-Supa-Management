# Zone for project hosts. One label is added in front:
#   {slug}.covixy.com          API
#   {slug}-studio.covixy.com   Studio
# A Cloudflare universal certificate covers a single label under this zone.
APEX_DOMAIN=covixy.com

# Leave PANEL_PASSWORD empty for a local unlocked panel.
# When it is set, also set PANEL_SESSION_SECRET.
PANEL_PASSWORD=
PANEL_SESSION_SECRET=

# 32-byte key, base64. Required in production. Dev creates data/dev-encryption.key when this is empty.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PANEL_ENCRYPTION_KEY=

# Capacity check. Each stack is estimated at 1536 MB.
SERVER_NAME=primary
SERVER_RAM_MB=8192
SERVER_RESERVE_MB=2048

# Coolify. All four are required before the panel calls the API.
# COOLIFY_API_URL is the instance origin, with or without /api/v1.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_DESTINATION_UUID=
